{
  "name": "solana-launchpad-stream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted real-time stream of Solana launchpad trades decoded straight from chain logs.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test \"test/*.test.mjs\"",
    "update-bundlers": "node scripts/update-bundler-wallets.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.13.6",
    "@grpc/proto-loader": "0.8.1",
    "bs58": "6.0.0",
    "laserstream-core-proto-js": "9.1.0",
    "sharp": "0.35.4",
    "ws": "8.18.0"
  }
}
