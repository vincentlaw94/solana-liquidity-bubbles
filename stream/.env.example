# Copy to .env (git-ignored) and fill in. npm start reads it automatically.

# Helius API key (a free one works). Uses LaserStream gRPC if your plan includes it (Business+),
# otherwise stays on the public websocket and re-checks every 6h. Account lookups use Helius RPC first.
LASERSTREAM_API_KEY=

# Daily cap on Helius RPC calls, so a free credit allowance lasts the cycle (~1M credits / 24 days).
HELIUS_DAILY_CALLS=40000

# Closest region: ewr (Newark), pitt, slc, lax, lon, ams, fra, tyo, sgp
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com

# PROCESSED = lowest latency (default). CONFIRMED = ~1s later, never shows a transaction that gets dropped.
LASERSTREAM_COMMITMENT=PROCESSED
